{
  "name": "twitch-miner",
  "private": true,
  "version": "1.15.3",
  "description": "Mine Twitch Drops, badges and channel points on as many accounts as you want, with no browser and no Twitch tab open.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SunkwiBOT/twitch-miner"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --workspace ./ui --tsconfig ./tsconfig.json --incremental --tsgo",
    "lint": "oxlint --deny-warnings ui/src",
    "format": "prettier --write \"ui/src/**/*.{ts,svelte,css}\" vite.config.js \"messages/*.json\"",
    "format:check": "prettier --check \"ui/src/**/*.{ts,svelte,css}\" vite.config.js \"messages/*.json\"",
    "bindings": "cargo run --quiet -p miner-core --example export-bindings -- ui/src/lib/bindings && prettier --write ui/src/lib/bindings",
    "i18n:check": "inlang check --project ./project.inlang --missing-translations --missing-variables --unknown-variables",
    "verify": "npm run format:check && npm run lint && npm run check && npm run i18n:check",
    "tauri": "tauri",
    "dev:app": "tauri dev",
    "build:app": "tauri build --no-bundle -- --locked",
    "bundle:linux": "NO_STRIP=true tauri build --bundles appimage,rpm,deb -- --locked",
    "bundle:windows": "tauri build --bundles nsis -- --locked",
    "bundle:macos": "tauri build --bundles app,dmg -- --locked",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@inlang/cli": "^3.6.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/plugin-message-format": "^4.6.0",
    "@lucide/svelte": "^1.77.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tsconfig/svelte": "^5.0.9",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "axios": "^1.21.1",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.2",
    "text-security": "^3.2.1"
  }
}
