{
  "name": "twitch-miner",
  "private": true,
  "version": "1.5.0",
  "description": "Mines Twitch Drops and channel points on several accounts, with no browser and no Twitch tab open.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SunkwiBOT/twitch-miner"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./ui/tsconfig.json",
    "lint": "oxlint --deny-warnings ui/src",
    "format": "prettier --write \"ui/src/**/*.{ts,svelte,css}\" vite.config.js",
    "format:check": "prettier --check \"ui/src/**/*.{ts,svelte,css}\" vite.config.js",
    "bindings": "cargo run --quiet -p miner-core --example export-bindings -- ui/src/lib/bindings && prettier --write ui/src/lib/bindings",
    "verify": "npm run format:check && npm run lint && npm run check",
    "tauri": "tauri",
    "dev:app": "tauri dev",
    "build:app": "tauri build --no-bundle -- --locked",
    "bundle:linux": "NO_STRIP=true tauri build --bundles appimage,rpm,deb -- --locked",
    "bundle:windows": "tauri build --bundles nsis -- --locked",
    "bundle:macos": "tauri build --bundles app,dmg -- --locked",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.26.0",
    "@inlang/plugin-message-format": "^4.4.5",
    "@lucide/svelte": "^1.52.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/cli": "^2.12.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tsconfig/svelte": "^5.0.8",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "axios": "^1.21.0",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "svelte-sonner": "^1.2.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1"
  }
}
